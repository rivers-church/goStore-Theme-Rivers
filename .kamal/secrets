# Kamal reads this file for the secrets named in config/deploy.yml. It holds no
# literal secrets, so it is committed. They come from the gitignored .env in this
# repo (copy .env.example); never commit that file.
KAMAL_REGISTRY_PASSWORD=$(gh auth token)
POSTGRES_PASSWORD=$(grep '^POSTGRES_PASSWORD=' .env | cut -d= -f2-)
# Assumes a password with no URL-special characters (the current one is alphanumeric).
DATABASE_URL=postgres://gostore:$(grep '^POSTGRES_PASSWORD=' .env | cut -d= -f2-)@gostore-postgres:5432/gostore?sslmode=disable
EMAIL_QUEUE_KEY=$(grep '^EMAIL_QUEUE_KEY=' .env | cut -d= -f2-)
GRAPH_TENANT_ID=$(grep '^GRAPH_TENANT_ID=' .env | cut -d= -f2-)
GRAPH_CLIENT_ID=$(grep '^GRAPH_CLIENT_ID=' .env | cut -d= -f2-)
GRAPH_CLIENT_SECRET=$(grep '^GRAPH_CLIENT_SECRET=' .env | cut -d= -f2-)
BLOB_ACCESS_KEY_ID=$(grep '^BLOB_ACCESS_KEY_ID=' .env | cut -d= -f2-)
BLOB_SECRET_ACCESS_KEY=$(grep '^BLOB_SECRET_ACCESS_KEY=' .env | cut -d= -f2-)
DOWNLOAD_ACCESS_KEY_ID=$(grep '^DOWNLOAD_ACCESS_KEY_ID=' .env | cut -d= -f2-)
DOWNLOAD_SECRET_ACCESS_KEY=$(grep '^DOWNLOAD_SECRET_ACCESS_KEY=' .env | cut -d= -f2-)
PAYFAST_MERCHANT_ID=$(grep '^PAYFAST_MERCHANT_ID=' .env | cut -d= -f2-)
PAYFAST_MERCHANT_KEY=$(grep '^PAYFAST_MERCHANT_KEY=' .env | cut -d= -f2-)
PAYFAST_PASSPHRASE=$(grep '^PAYFAST_PASSPHRASE=' .env | cut -d= -f2-)
